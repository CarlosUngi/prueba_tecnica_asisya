# ==========================================
# .NET / C# Exclusions
# ==========================================
bin/
obj/
out/
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.suo

# NuGet
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Build and Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.cache

# Entity Framework Migrations output temporary files
*.designer.cs

# ==========================================
# Node.js / React / Frontend Exclusions
# ==========================================
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Output
frontend/dist/
frontend/build/

# Frontend Cache
.eslintcache
.stylelintcache
.vite/
frontend/.vite/

# ==========================================
# IDEs and Tools
# ==========================================
# Visual Studio
.vs/
*.csproj.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (Rider, WebStorm)
.idea/
*.sln.iml

# ==========================================
# Environment Variables & Local Configs
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
appsettings.Development.json
appsettings.Local.json

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
